{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prax",
  "version": "../package.json",
  "identifier": "com.moomora.prax",
  "build": {
    "beforeDevCommand": "node scripts/prepare-sidecar.mjs",
    "beforeBuildCommand": "node scripts/prepare-sidecar.mjs",
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Tasks, notes, and runbooks in a calm desktop app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/prax-server"],
    "resources": ["resources/app"]
  }
}
